{
  "name": "@rqlang/mcp",
  "version": "0.0.0",
  "description": "MCP server that teaches AI assistants to write rqlang (.rq) HTTP request files",
  "license": "MIT",
  "homepage": "https://www.rqlang.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rqlang/rq.git",
    "directory": "src/rq-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rq",
    "rqlang",
    "http",
    "api",
    "ai"
  ],
  "bin": {
    "rq-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build-wasm": "wasm-pack build ../rq-wasm --target nodejs --out-dir ./src/wasm",
    "build": "node build.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node build.js --production"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "zod": "^4.6.5"
  }
}
