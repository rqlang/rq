{
  "name": "rq-language",
  "displayName": "rq",
  "description": "Language support for rq, a language for managing and executing HTTP requests",
  "version": "0.1.0",
  "publisher": "rq-lang",
  "icon": "rq.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rqlang/rq"
  },
  "homepage": "https://www.rqlang.com",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "AI"
  ],
  "keywords": [
    "rq",
    "HTTP",
    "REST",
    "API",
    "request",
    "OAuth2",
    "language",
    "API client",
    "MCP",
    "Copilot",
    "AI"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "rq",
        "aliases": [
          "RQ",
          "rq"
        ],
        "extensions": [
          ".rq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rq",
        "scopeName": "source.rq",
        "path": "./syntaxes/rq.tmLanguage.json"
      },
      {
        "scopeName": "source.rq.basic",
        "path": "./syntaxes/basic-types.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rq",
        "path": "./snippets/rq.code-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "rq.getToken",
        "title": "Get OAuth2 Token",
        "category": "RQ"
      },
      {
        "command": "rq.clearOAuthCache",
        "title": "Clear OAuth2 Cache",
        "category": "RQ"
      },
      {
        "command": "rq.refreshRequests",
        "title": "Refresh Requests",
        "category": "RQ",
        "icon": "$(refresh)"
      },
      {
        "command": "rq.selectEnvironment",
        "title": "Select Environment",
        "category": "RQ",
        "icon": "$(server-environment)"
      },
      {
        "command": "rq.openRequestFile",
        "title": "Open Request File",
        "category": "RQ"
      },
      {
        "command": "rq.openConfigurationFile",
        "title": "Open Configuration File",
        "category": "RQ"
      },
      {
        "command": "rq.openEndpoint",
        "title": "Open Endpoint File",
        "category": "RQ"
      },
      {
        "command": "rq.refreshConfiguration",
        "title": "Refresh Configuration",
        "category": "RQ",
        "icon": "$(refresh)"
      },
      {
        "command": "rq.runRequest",
        "title": "Run Request",
        "category": "RQ",
        "icon": "$(play)",
        "enablement": "!rq.requestRunning"
      },
      {
        "command": "rq.runRequestWithVariables",
        "title": "Run Request with Variables",
        "category": "RQ",
        "icon": "$(run-with-deps)",
        "enablement": "!rq.requestRunning"
      },
      {
        "command": "rq.cancelRequest",
        "title": "Cancel Running Request",
        "category": "RQ",
        "icon": "$(stop-circle)",
        "enablement": "rq.requestRunning"
      }
    ],
    "configuration": {
      "title": "RQ",
      "properties": {
        "rq.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Show debug logs in the RQ output window: request execution details and the rq library trace (files parsed, environments, secret and variable sources, auth and HTTP exchanges). Secret values are masked."
        },
        "rq.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show rqlang idiom and style lint warnings in the editor, alongside syntax errors."
        },
        "rq.results.tabMode": {
          "type": "string",
          "enum": [
            "single",
            "perRequest",
            "perExecution"
          ],
          "enumDescriptions": [
            "Reuse one results tab for every request.",
            "Open one results tab per request; running a request again reuses its tab.",
            "Open a new results tab every time a request runs from the explorer. Run again reuses the tab it is clicked in."
          ],
          "default": "single",
          "description": "How request results are distributed across editor tabs."
        }
      }
    },
    "configurationDefaults": {
      "[rq]": {
        "editor.snippetSuggestions": "none",
        "editor.wordBasedSuggestions": "off"
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "rq-lang.rq-mcp",
        "label": "rq"
      }
    ],
    "authentication": [
      {
        "id": "rq-azure-oauth",
        "label": "RQ Azure OAuth"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rq-explorer",
          "title": "RQ",
          "icon": "$(globe)"
        }
      ]
    },
    "colors": [
      {
        "id": "rq.environment.red",
        "description": "Color of an environment marked with [ui.color(red)] in the Requests view.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red",
          "highContrast": "charts.red",
          "highContrastLight": "charts.red"
        }
      },
      {
        "id": "rq.environment.orange",
        "description": "Color of an environment marked with [ui.color(orange)] in the Requests view.",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange",
          "highContrastLight": "charts.orange"
        }
      },
      {
        "id": "rq.environment.yellow",
        "description": "Color of an environment marked with [ui.color(yellow)] in the Requests view.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "rq.environment.green",
        "description": "Color of an environment marked with [ui.color(green)] in the Requests view.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "rq.environment.blue",
        "description": "Color of an environment marked with [ui.color(blue)] in the Requests view.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      },
      {
        "id": "rq.environment.purple",
        "description": "Color of an environment marked with [ui.color(purple)] in the Requests view.",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple",
          "highContrastLight": "charts.purple"
        }
      }
    ],
    "views": {
      "rq-explorer": [
        {
          "id": "rqRequestExplorer",
          "name": "Requests",
          "icon": "$(globe)",
          "visibility": "visible"
        },
        {
          "id": "rqConfigurationExplorer",
          "name": "Configuration",
          "icon": "$(symbol-misc)",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rq.selectEnvironment",
          "when": "view == rqRequestExplorer",
          "group": "navigation"
        },
        {
          "command": "rq.refreshRequests",
          "when": "view == rqRequestExplorer",
          "group": "navigation"
        },
        {
          "command": "rq.refreshConfiguration",
          "when": "view == rqConfigurationExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "rq.cancelRequest",
          "when": "view == rqRequestExplorer && viewItem == request-running",
          "group": "inline@1"
        },
        {
          "command": "rq.runRequest",
          "when": "view == rqRequestExplorer && viewItem == request",
          "group": "inline@1"
        },
        {
          "command": "rq.runRequestWithVariables",
          "when": "view == rqRequestExplorer && viewItem == request",
          "group": "inline@2"
        },
        {
          "command": "rq.openRequestFile",
          "when": "view == rqRequestExplorer && viewItem == request",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "rq.cancelRequest",
          "when": "rq.requestRunning"
        }
      ]
    }
  },
  "scripts": {
    "build-wasm": "wasm-pack build ../rq-wasm --target nodejs --out-dir ./src/wasm",
    "copy-wasm": "node -e \"const fs=require('fs');const src='../rq-wasm/src/wasm';if(fs.existsSync(src+'/rq_wasm.js')){fs.mkdirSync('out/wasm',{recursive:true});['rq_wasm.js','rq_wasm_bg.wasm'].forEach(f=>fs.copyFileSync(src+'/'+f,'out/wasm/'+f));}else{console.log('WASM not built, skipping wasm copy');}\"",
    "vscode:prepublish": "npm run build-wasm && node esbuild.js --production && npm run copy-wasm",
    "compile": "node esbuild.js && npm run copy-wasm",
    "dev:host": "npm run compile && code --extensionDevelopmentPath=\"$PWD\" \"${RQ_SANDBOX:-$PWD/../../../rq-lint-sandbox}\"",
    "watch": "node esbuild.js --watch",
    "pretest": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/vscode": "~1.110.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "node-forge": "^1.4.0",
    "zod": "^4.6.5"
  }
}
